# Copy to .env when the backend lands. .env is gitignored.

# Claude auth: NONE HERE. This backend uses your Claude subscription via the
# Agent SDK, which reuses the Claude Code login on this machine. Log in once
# with the Claude Code CLI (see BACKEND_SETUP.md). There is no
# ANTHROPIC_API_KEY for the subscription path.

# MongoDB Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/stoa?retryWrites=true&w=majority

# Server Configuration
PORT=3001

