# Copy to server/sync/.env. .env is gitignored.
# This is the always-on sync API's own env — separate from the repo-root
# .env used by the frontend build and the desktop assistant server.

MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/stoa?retryWrites=true&w=majority
SYNC_TOKEN=change-me-to-a-long-random-string
PORT=4000
