# Copy to server/sync/.env. .env is gitignored.
# This is the always-on sync API's own env — separate from the repo-root
# .env used by the frontend build and the desktop assistant server.

MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/stoa?retryWrites=true&w=majority
SYNC_TOKEN=change-me-to-a-long-random-string
PORT=4000

# Push notifications (optional) -- unset means nudges only fire from an open
# tab, same as before this existed. Generate with:
#   npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Quiet hours the push runner uses, in minutes since local midnight (default
# 23:00-07:00, matching the client default). The client's own Quiet hours
# setting is device-local and never reaches the server, so if you've changed
# it there, set the same window here to match.
QUIET_START_MIN=
QUIET_END_MIN=
